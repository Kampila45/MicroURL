# Application environment: development | production
APP_ENV=development

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgres://microurl:microurl_dev_password@localhost:5432/microurl?sslmode=disable

# Public base URL used for generated short links and QR codes
BASE_URL=http://localhost:8080
PORT=8080

# Upstash Redis REST API & entry TTL (seconds)
# For local Docker Compose, use http://localhost:8079 with microurl_dev_redis_token
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=microurl_dev_redis_token
CACHE_TTL=3600

# Per-IP token-bucket rate limiting
RATE_LIMIT_RPS=10.0
RATE_LIMIT_BURST=20

# Comma-separated trusted reverse proxy IPs or CIDRs (empty ignores X-Forwarded-For / X-Real-IP)
TRUSTED_PROXIES=

# Cloudflare Turnstile verification secret (required when APP_ENV=production)
TURNSTILE_SECRET_KEY=
